        "---\n",
        "title: \"Experiment Results\"\n",
        "format:\n",
        "  revealjs:\n",
        "    theme: simple\n",
        "    transition: slide\n",
        "    slide-number: true\n",
        "    controls: true\n",
        "    progress: true\n",
        "    css: styles.css\n",
        "execute:\n",
        "  echo: false\n",
        "  warning: false\n",
        "  message: false\n",
        "---\n",
        "\n",
        "```{=html}\n",
        "<script>\n",
        "window.fitScaledWriteupFrame = function(frame) {\n",
        "  const content = frame.querySelector(\".scaled-frame-content\");\n",
        "  const sourceWidth = Number(frame.dataset.sourceWidth);\n",
        "  const sourceHeight = Number(frame.dataset.sourceHeight);\n",
        "  if (!content || !sourceWidth || !sourceHeight) return;\n",
        "\n",
        "  const displayWidth = frame.clientWidth;\n",
        "  if (!displayWidth) return;\n",
        "\n",
        "  const scale = Math.min(1, displayWidth / sourceWidth);\n",
        "  const extraHeight = Number(frame.dataset.extraHeight || 0);\n",
        "  frame.style.maxWidth = \"100%\";\n",
        "  frame.style.height = `${Math.ceil(sourceHeight * scale + extraHeight)}px`;\n",
        "  frame.style.overflow = \"hidden\";\n",
        "  content.style.width = `${sourceWidth}px`;\n",
        "  content.style.height = `${sourceHeight}px`;\n",
        "  content.style.display = content.dataset.scaledDisplay || \"block\";\n",
        "  content.style.transformOrigin = \"top left\";\n",
        "  content.style.transform = `scale(${scale})`;\n",
        "};\n",
        "\n",
        "window.fitAllScaledWriteupFrames = function(root) {\n",
        "  (root || document)\n",
        "    .querySelectorAll(\".scaled-frame\")\n",
        "    .forEach((frame) => window.fitScaledWriteupFrame(frame));\n",
        "};\n",
        "\n",
        "window.tabPaneForWriteupFrame = function(frame) {\n",
        "  let node = frame.parentElement;\n",
        "  while (node && node.parentElement) {\n",
        "    if (node.parentElement.classList.contains(\"tab-content\")) return node;\n",
        "    node = node.parentElement;\n",
        "  }\n",
        "  return null;\n",
        "};\n",
        "\n",
        "window.canHydrateWriteupFrame = function(frame) {\n",
        "  const tabset = frame.closest(\".panel-tabset\");\n",
        "  if (tabset) {\n",
        "    const panes = Array.from(tabset.querySelectorAll(\".tab-content > div\"));\n",
        "    const tabsetReady = panes.length <= 1 || panes.some((pane) => pane.hidden);\n",
        "    const pane = window.tabPaneForWriteupFrame(frame);\n",
        "    if (!tabsetReady || (pane && pane.hidden)) return false;\n",
        "  }\n",
        "  const rect = frame.getBoundingClientRect();\n",
        "  return Boolean(rect.width && rect.height && frame.offsetParent !== null);\n",
        "};\n",
        "\n",
        "window.hydrateScaledWriteupFrames = function(root) {\n",
        "  (root || document)\n",
        "    .querySelectorAll(\"iframe.metric-frame[data-src]\")\n",
        "    .forEach((frame) => {\n",
        "      if (frame.getAttribute(\"src\")) return;\n",
        "      if (!window.canHydrateWriteupFrame(frame)) return;\n",
        "      frame.setAttribute(\"src\", frame.dataset.src);\n",
        "    });\n",
        "};\n",
        "\n",
        "window.dehydrateHiddenScaledWriteupFrames = function(root) {\n",
        "  (root || document)\n",
        "    .querySelectorAll(\"iframe.metric-frame[data-src][src]\")\n",
        "    .forEach((frame) => {\n",
        "      const pane = window.tabPaneForWriteupFrame(frame);\n",
        "      if (pane && pane.hidden) frame.removeAttribute(\"src\");\n",
        "    });\n",
        "};\n",
        "\n",
        "window.refreshScaledWriteupFrames = function(root) {\n",
        "  window.dehydrateHiddenScaledWriteupFrames(root || document);\n",
        "  window.hydrateScaledWriteupFrames(root);\n",
        "  window.fitAllScaledWriteupFrames(root);\n",
        "};\n",
        "\n",
        "window.scheduleScaledWriteupRefresh = function(root) {\n",
        "  requestAnimationFrame(() =>\n",
        "    requestAnimationFrame(() => window.refreshScaledWriteupFrames(root))\n",
        "  );\n",
        "};\n",
        "\n",
        "window.addEventListener(\"DOMContentLoaded\", () => {\n",
        "  window.scheduleScaledWriteupRefresh(document);\n",
        "  window.addEventListener(\"load\", () => window.scheduleScaledWriteupRefresh(document));\n",
        "  if (\"ResizeObserver\" in window) {\n",
        "    const obs = new ResizeObserver((entries) =>\n",
        "      entries.forEach((entry) => window.scheduleScaledWriteupRefresh(entry.target))\n",
        "    );\n",
        "    document\n",
        "      .querySelectorAll(\".scaled-frame\")\n",
        "      .forEach((frame) => obs.observe(frame));\n",
        "  } else {\n",
        "    window.addEventListener(\"resize\", () =>\n",
        "      window.scheduleScaledWriteupRefresh(document)\n",
        "    );\n",
        "  }\n",
        "  document.addEventListener(\"shown.bs.tab\", (event) => {\n",
        "    window.scheduleScaledWriteupRefresh(event.target.closest(\".panel-tabset\"));\n",
        "  });\n",
        "  document.addEventListener(\"tabby\", (event) => {\n",
        "    window.scheduleScaledWriteupRefresh(event.target.closest(\".panel-tabset\"));\n",
        "  });\n",
        "  if (window.Reveal && typeof window.Reveal.on === \"function\") {\n",
        "    window.Reveal.on(\"slidechanged\", () =>\n",
        "      window.scheduleScaledWriteupRefresh(document)\n",
        "    );\n",
        "  }\n",
        "});\n",
        "</script>\n",
        "```"
      ],
