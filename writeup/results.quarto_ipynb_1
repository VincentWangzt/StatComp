        "#| output: asis\n",
        "from pathlib import Path\n",
        "import json\n",
        "import pandas as pd\n",
        "\n",
        "CAMPAIGN = \"kdvi_dsivi_toy_default_sweep_10seed\"\n",
        "DATA_DIR = Path(\"data\") / CAMPAIGN\n",
        "PLOT_DIR = Path(\"assets\") / \"plotly\" / CAMPAIGN\n",
        "VISUAL_MANIFEST = DATA_DIR / \"visual_manifest.json\"\n",
        "PLOTLY_SOURCE_WIDTH = 1000\n",
        "PLOTLY_SOURCE_HEIGHT = 480\n",
        "VISUAL_SOURCE_WIDTH = 1100\n",
        "VISUAL_SOURCE_HEIGHT = 480\n",
        "TARGET_ORDER = [\n",
        "    \"banana\",\n",
        "    \"x_shaped\",\n",
        "    \"multimodal\",\n",
        "    \"8_gaussians\",\n",
        "    \"8_gaussians_small\",\n",
        "    \"student_uc\",\n",
        "    \"Langevin_post\",\n",
        "]\n",
        "METRIC_ORDER = [\n",
        "    (\"kl_ite\", \"KL-ITE\", \"KL\"),\n",
        "    (\"w2\", \"Sliced W2\", \"W2\"),\n",
        "    (\"elbo\", \"ELBO\", \"ELBO\"),\n",
        "    (\"kde_expected_log_marginal\", \"KDE ELM\", \"KDE ELM\"),\n",
        "]\n",
        "TARGET_LABELS = {\n",
        "    \"banana\": \"banana\",\n",
        "    \"x_shaped\": \"x_shaped\",\n",
        "    \"multimodal\": \"multimodal\",\n",
        "    \"8_gaussians\": \"8_gaussians\",\n",
        "    \"8_gaussians_small\": \"8_gaussians_small\",\n",
        "    \"student_uc\": \"student_uc\",\n",
        "    \"Langevin_post\": \"Langevin_post\",\n",
        "}\n",
        "\n",
        "\n",
        "def fmt(value):\n",
        "    if pd.isna(value):\n",
        "        return \"-\"\n",
        "    return f\"{value:.4g}\"\n",
        "\n",
        "\n",
        "def read_manifest():\n",
        "    if not VISUAL_MANIFEST.exists():\n",
        "        return {}\n",
        "    return json.loads(VISUAL_MANIFEST.read_text(encoding=\"utf-8\"))\n",
        "\n",
        "\n",
        "def target_id(target):\n",
        "    return target.replace(\"_\", \"-\").lower()\n",
        "\n",
        "\n",
        "def frame_epoch(frame):\n",
        "    return frame.get(\"epoch\", frame.get(\"step\", \"\"))\n",
        "\n",
        "\n",
        "def count_value(value):\n",
        "    if pd.isna(value):\n",
        "        return 0\n",
        "    return int(value)\n",
        "\n",
        "\n",
        "def metric_value(item, metric):\n",
        "    mean_col = f\"{metric}_final_mean\"\n",
        "    std_col = f\"{metric}_final_std\"\n",
        "    count_col = f\"{metric}_final_count\"\n",
        "    if mean_col not in item or count_value(item.get(count_col, 0)) == 0:\n",
        "        return \"-\"\n",
        "    std = item.get(std_col)\n",
        "    if pd.isna(std):\n",
        "        return fmt(item[mean_col])\n",
        "    return f\"{fmt(item[mean_col])} +/- {fmt(std)}\"\n",
        "\n",
        "\n",
        "def target_metric_table(target_rows):\n",
        "    cols = [\"Method\", \"Runs\"]\n",
        "    for _, table_label, _ in METRIC_ORDER:\n",
        "        cols.append(table_label)\n",
        "\n",
        "    rows = []\n",
        "    for method in [\"KDVI\", \"DSIVI\"]:\n",
        "        row = target_rows[target_rows[\"method\"] == method]\n",
        "        if row.empty:\n",
        "            continue\n",
        "        item = row.iloc[0]\n",
        "        values = [method, str(int(item[\"run_count\"]))]\n",
        "        for metric, _, _ in METRIC_ORDER:\n",
        "            values.append(metric_value(item, metric))\n",
        "        rows.append(values)\n",
        "    return pd.DataFrame(rows, columns=cols)\n",
        "\n",
        "\n",
        "summary_path = DATA_DIR / \"final_metrics.csv\"\n",
        "if not summary_path.exists():\n",
        "    raise FileNotFoundError(\n",
        "        f\"Missing {summary_path}. Run \"\n",
        "        f\"`python writeup/scripts/fetch_wandb_campaign.py {CAMPAIGN}` first.\"\n",
        "    )\n",
        "\n",
        "summary = pd.read_csv(summary_path)\n",
        "visuals = read_manifest()\n",
        "\n",
        "for target in TARGET_ORDER:\n",
        "    target_label = TARGET_LABELS[target]\n",
        "    target_html_id = target_id(target)\n",
        "    target_rows = summary[summary[\"target\"] == target]\n",
        "    print(f'<section id=\"results-{target_html_id}\"><h2>{target_label}</h2>')\n",
        "    print(\n",
        "        '<p class=\"target-definition-link\">'\n",
        "        f'<a href=\"implementation.html#sec-target-{target_html_id}\">'\n",
        "        \"Target definition</a></p>\"\n",
        "    )\n",
        "    print('::: {.panel-tabset .target-tabs}')\n",
        "    print('')\n",
        "    plotted = False\n",
        "    for metric, _, tab_label in METRIC_ORDER:\n",
        "        plot_path = PLOT_DIR / f\"{target}_{metric}.html\"\n",
        "        if plot_path.exists():\n",
        "            plotted = True\n",
        "            print(f\"## {tab_label}\")\n",
        "            print(\"\")\n",
        "            print(\n",
        "                '<div class=\"scaled-frame scaled-plotly-frame\" '\n",
        "                f'data-source-width=\"{PLOTLY_SOURCE_WIDTH}\" '\n",
        "                f'data-source-height=\"{PLOTLY_SOURCE_HEIGHT}\" '\n",
        "                'data-extra-height=\"8\">'\n",
        "                f'<iframe class=\"metric-frame scaled-frame-content\" '\n",
        "                f'data-src=\"{plot_path.as_posix()}\" '\n",
        "                f'width=\"{PLOTLY_SOURCE_WIDTH}\" height=\"{PLOTLY_SOURCE_HEIGHT}\" '\n",
        "                'scrolling=\"no\" '\n",
        "                'onload=\"window.fitScaledWriteupFrame(this.parentElement);\">'\n",
        "                '</iframe></div>'\n",
        "            )\n",
        "            print(\"\")\n",
        "    if not plotted:\n",
        "        print(\"## No Plots\")\n",
        "        print(\"\")\n",
        "        print(\"No metric plot is available for this target.\")\n",
        "        print(\"\")\n",
        "\n",
        "    print(\"## Visuals\")\n",
        "    print(\"\")\n",
        "    target_visual = visuals.get(target, {})\n",
        "    groundtruth = target_visual.get(\"groundtruth\")\n",
        "    posterior = target_visual.get(\"posterior\", [])\n",
        "    if groundtruth and posterior:\n",
        "        slider_id = f\"slider-{target_html_id}\"\n",
        "        img_id = f\"posterior-{target_html_id}\"\n",
        "        caption_id = f\"caption-{target_html_id}\"\n",
        "        first = posterior[0]\n",
        "        print(\n",
        "            '<div class=\"scaled-frame scaled-visual-frame\" '\n",
        "            f'data-source-width=\"{VISUAL_SOURCE_WIDTH}\" '\n",
        "            f'data-source-height=\"{VISUAL_SOURCE_HEIGHT}\">'\n",
        "        )\n",
        "        print('<div class=\"visual-grid scaled-frame-content\" data-scaled-display=\"grid\">')\n",
        "        print('<div class=\"visual-panel\">')\n",
        "        print('<h3>Groundtruth</h3>')\n",
        "        print(f'<img src=\"{groundtruth}\" alt=\"Groundtruth samples for {target}\">')\n",
        "        print('</div>')\n",
        "        print('<div class=\"visual-panel posterior-panel\">')\n",
        "        print('<h3>KDVI posterior, seed 7</h3>')\n",
        "        print(\n",
        "            f'<img id=\"{img_id}\" src=\"{first[\"path\"]}\" '\n",
        "            f'alt=\"KDVI posterior samples for {target}\">'\n",
        "        )\n",
        "        print(\n",
        "            f'<input id=\"{slider_id}\" type=\"range\" min=\"0\" '\n",
        "            f'max=\"{len(posterior) - 1}\" value=\"0\" step=\"1\">'\n",
        "        )\n",
        "        print(\n",
        "            f'<div id=\"{caption_id}\" class=\"posterior-caption\">'\n",
        "            f'epoch {frame_epoch(first)}</div>'\n",
        "        )\n",
        "        print('</div>')\n",
        "        print('</div>')\n",
        "        print('</div>')\n",
        "        payload = json.dumps(posterior)\n",
        "        print(\"<script>\")\n",
        "        print(\n",
        "            f\"(function(){{const frames={payload};\"\n",
        "            f\"const slider=document.getElementById('{slider_id}');\"\n",
        "            f\"const image=document.getElementById('{img_id}');\"\n",
        "            f\"const caption=document.getElementById('{caption_id}');\"\n",
        "            \"if(!slider||!image||!caption){return;}\"\n",
        "            \"function update(){const item=frames[Number(slider.value)];\"\n",
        "            \"const epoch=(item.epoch ?? item.step);\"\n",
        "            \"image.src=item.path; caption.textContent='epoch '+epoch;}\"\n",
        "            \"slider.addEventListener('input', update); update();\"\n",
        "            \"requestAnimationFrame(()=>window.fitAllScaledWriteupFrames(document));})();\"\n",
        "        )\n",
        "        print(\"</script>\")\n",
        "    else:\n",
        "        print(\"No seed-7 visualization media is available for this target.\")\n",
        "    print(\"\")\n",
        "\n",
        "    print(\"## Table\")\n",
        "    print(\"\")\n",
        "    target_table = target_metric_table(target_rows)\n",
        "    if target_table.empty:\n",
        "        print(\"No final metric summary is available for this target.\")\n",
        "    else:\n",
        "        print(f'<h3>{target_label} final metrics</h3>')\n",
        "        print('<div class=\"metric-table target-metric-table\">')\n",
        "        print(target_table.to_html(index=False, escape=False))\n",
        "        print(\"</div>\")\n",
        "    print(\"\")\n",
        "\n",
        "    print(\":::\")\n",
        "    print(\"</section>\")"
